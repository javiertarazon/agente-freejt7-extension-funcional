{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🎬 Debug Pipeline Completo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agents/video_pipeline_agent.py",
      "args": [
        "--prompt", "Video demo para debug de 5 segundos",
        "--verbose"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "🎨 Debug Claude Design Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agents/claude_design_agent.py",
      "args": [
        "--prompt", "Diseño minimalista de prueba",
        "--verbose"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "⚛️ Debug Remotion Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agents/remotion_agent.py",
      "args": [
        "--design", "design_output.json",
        "--only-code",
        "--verbose"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "🔄 Debug Pipeline Interactivo",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agents/video_pipeline_agent.py",
      "args": ["--interactive"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
