# ─── Anthropic Claude API ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-REEMPLAZA_CON_TU_API_KEY

# Modelo a usar (claude-sonnet-4-6 es recomendado)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Rutas del Proyecto ───────────────────────────────────────
# Ruta al proyecto Remotion
REMOTION_PROJECT_PATH=./remotion_project

# Directorio para videos de salida
OUTPUT_VIDEO_PATH=./output_videos

# ─── Configuración de Video ───────────────────────────────────
# Resolución por defecto (se puede sobreescribir en el prompt)
DEFAULT_WIDTH=1920
DEFAULT_HEIGHT=1080
DEFAULT_FPS=30

# ─── Opciones de Debug ────────────────────────────────────────
# Muestra output detallado de Claude
VERBOSE=false
# Guarda archivos intermedios (JSON, TSX)
SAVE_INTERMEDIATES=true
